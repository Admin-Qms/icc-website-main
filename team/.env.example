# Copy to team/.env and fill in. Never commit team/.env.

# --- Who answers the text calls ------------------------------------------
# Providers in order (openai, gemini, claude): the next one is tried when one
# fails, and one without a key is skipped. The older single LLM_PROVIDER still
# works; with neither set, whichever key below is present is used.
LLM_PROVIDERS=openai,gemini

OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=

# Optional model overrides (defaults are in agents/shared/config.js)
# OPENAI_TEXT_MODEL=gpt-6.1-terra        # topic pick, chapter reviewer, outline
# OPENAI_TEXT_MODEL_FAST=gpt-6-luna      # originality, claims audit, cleaner, grammar, guide audit
# OPENAI_IMAGE_MODEL=gpt-image-2
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# --- Images --------------------------------------------------------------
# Pexels is tried first; Gemini generates an image when Pexels has nothing
# unused. With only GEMINI_API_KEY set, every image is generated.
PEXELS_API_KEY=

# --- Optional ------------------------------------------------------------
# BLOG_AUTHOR=ISO Certification Consultant Editorial Team
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_ID=
