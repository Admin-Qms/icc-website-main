# Copy to team/.env and fill in. Never commit team/.env.

# --- Who writes the text -------------------------------------------------
# gemini or claude. If unset, whichever key below is present is used
# (Claude wins when both are set).
LLM_PROVIDER=gemini

GEMINI_API_KEY=
CLAUDE_API_KEY=

# Optional model overrides (defaults are in agents/shared/config.js)
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# --- Images --------------------------------------------------------------
# Pexels is tried first; Gemini generates an image when Pexels has nothing
# unused. With only GEMINI_API_KEY set, every image is generated.
PEXELS_API_KEY=

# --- Optional ------------------------------------------------------------
# BLOG_AUTHOR=ISO Certification Consultant Editorial Team
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_ID=
